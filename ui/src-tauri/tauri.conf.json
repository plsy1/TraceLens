{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TraceLens",
  "version": "0.0.2",
  "identifier": "io.tracelens.desktop",
  "build": {
    "beforeDevCommand": "../scripts/prepare-desktop.sh debug && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "../scripts/prepare-desktop.sh release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TraceLens",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Process-aware Linux network capture",
    "longDescription": "TraceLens is a process-aware Linux network capture utility powered by eBPF.",
    "icon": ["icons/icon.png"],
    "resources": {
      "resources/bin/tracelens-core": "bin/tracelens-core",
      "resources/bpf/objects/": "bpf/objects/",
      "resources/lib/": "lib/"
    },
    "linux": {
      "deb": {
        "depends": [
          "pkexec"
        ]
      }
    }
  }
}
